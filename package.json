{
  "name": "herdr-relay",
  "version": "0.2.0-rc.3",
  "private": true,
  "license": "MIT",
  "description": "Connect Paperclip work to agents in herdr",
  "type": "module",
  "exports": {
    ".": "./src/adapter.mjs",
    "./server": "./src/adapter.mjs"
  },
  "bin": {
    "herdr-relay": "./src/cli.mjs",
    "herdr-relay-remote": "./src/remote.mjs"
  },
  "files": [
    "src",
    "packages/opencode-relay/*.mjs",
    "packages/opencode-relay/package.json",
    "packages/opencode-relay/package-lock.json",
    "skills",
    "scripts/plugin-launch.sh",
    "scripts/toggle-board.py",
    "scripts/native-board-launch.mjs",
    "scripts/native-agent-launch.mjs",
    "scripts/install-native-node.mjs",
    "scripts/install-native-backend.mjs",
    "scripts/verify-backend-ingress.mjs",
    "scripts/migrate-paperclip-tasks.mjs",
    "herdr-plugin.toml",
    "docs/*.md"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "board": "node src/cli.mjs native board",
    "start": "node src/cli.mjs service",
    "check": "node scripts/check.mjs",
    "test": "node --test test/*.test.mjs",
    "test:v2": "npm --prefix packages/opencode-relay test",
    "smoke:v2": "npm --prefix packages/opencode-relay run smoke -- --tui"
  },
  "dependencies": {
    "@opencode-ai/plugin": "1.18.27",
    "@opencode/client": "2.1.0",
    "@opencode/plugin": "2.1.0",
    "ink": "^8.0.0",
    "jsonc-parser": "3.3.1",
    "react": "^19.3.0",
    "solid-js": "1.9.17"
  },
  "devDependencies": {
    "ink-testing-library": "^4.0.0"
  }
}
